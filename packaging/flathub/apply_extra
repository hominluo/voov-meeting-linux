#!/bin/sh
# Runs at install/update time (Flatpak's extra-data hook). The release .deb is
# downloaded by Flatpak, not by the build; unpack just the /opt tree into /app.
set -eu

cd /app/extra

python3 - <<'PY'
import sys

raw = open("voov-meeting.deb", "rb").read()
if raw[:8] != b"!<arch>\n":
    sys.exit("not an ar archive")
off = 8
found = False
while off + 60 <= len(raw):
    hdr = raw[off:off + 60]
    name = hdr[:16].decode("ascii").strip()
    size = int(hdr[48:58].decode("ascii").strip())
    body = raw[off + 60:off + 60 + size]
    if name.startswith("data.tar"):
        open("data.tar.xz", "wb").write(body)
        found = True
    off += 60 + size + (size & 1)
if not found:
    sys.exit("no data.tar in the .deb")
PY

tar -xJf data.tar.xz -C /app ./opt
rm -f voov-meeting.deb data.tar.xz
