<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>MIT</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>VooV Meeting</name>
  <summary>Cross-border video conferencing</summary>
  <description>
    <p>
      VooV Meeting is Tencent's international video-conferencing client.
      Tencent ships VooV only for Windows and macOS, so this unofficial
      package republishes Tencent's official Linux client with small binary
      patches that switch it to VooV's regional settings and endpoints. It
      runs natively — no Wine.
    </p>
    <p>Release @RELEASE_NAME@.</p>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/hominluo/voov-meeting-linux</url>
  <developer id="com.voovmeeting">
    <name>Homin Luo</name>
  </developer>
  <content_rating type="oars-1.1" />
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/hominluo/voov-meeting-linux/main/docs/screenshot.png</image>
      <caption>VooV Meeting login window</caption>
    </screenshot>
  </screenshots>
</component>
