Name:           voov-meeting
Version:        @VERSION@
Release:        @RELEASE@
Summary:        Unofficial VooV Meeting Linux client (Wine)
License:        Proprietary
URL:            https://github.com/hominluo/voov-meeting-linux
BuildArch:      x86_64
AutoReqProv:    no

Requires:       wine
Requires:       desktop-file-utils

%define _binary_payload w9.xzdio
# The bundled PE files are not ELF and carry no usable RPM dependencies;
# AutoReqProv is off and the payload is installed verbatim.
%define __arch_install_post %{nil}
%global debug_package %{nil}

%description
VooV Meeting is Tencent's international video-conferencing client.

Tencent does not ship a Linux client, so this package runs the official
VooV Meeting @VERSION@ for Windows under Wine and adds native Linux desktop
integration. The client is installed read-only under /opt and copied into a
per-user Wine prefix on first start.

This is an unofficial community build. The bundled application is proprietary
Tencent software; only the packaging and helper scripts are MIT licensed.

%install
mkdir -p %{buildroot}
cp -a /src/build/rpm-root/. %{buildroot}/

%files
/opt/voov-meeting
/usr/bin/voov-meeting
/usr/share/applications/voov-meeting.desktop
/usr/share/icons/hicolor/*/apps/voov-meeting.png
/usr/share/pixmaps/voov-meeting.png
/usr/share/doc/voov-meeting

%changelog
* Mon Nov 16 2026 Homin Luo <homin.ro@gmail.com> - @VERSION@-@RELEASE@
- VooV Meeting @VERSION@ (Windows build) running under Wine
